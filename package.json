{
  "name": "study-community",
  "version": "1.0.0",
  "description": "A Chinese learning community for logistics management and computer science, with private resources, project sharing and PDF discussions.",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx scripts/seed.ts",
    "setup": "tsx scripts/setup.ts",
    "mail": "tsx scripts/mailpit.ts",
    "mail:check": "tsx scripts/check-smtp.ts",
    "backup": "tsx scripts/backup.ts",
    "projects:worker": "tsx scripts/project-worker.ts",
    "package:github": "node scripts/package-github-source.mjs",
    "predev": "node scripts/prepare-pdf.mjs",
    "prebuild": "node scripts/prepare-pdf.mjs"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@radix-ui/react-slot": "^1.2.3",
    "better-auth": "^1.4.0",
    "better-sqlite3": "^12.10.0",
    "busboy": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "fflate": "0.8.3",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "nodemailer": "^7.0.0",
    "pdfjs-dist": "6.4.299",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.4.0",
    "yauzl": "3.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/busboy": "^1.5.4",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/yauzl": "2.10.3",
    "prettier": "^3.9.9",
    "prisma": "^7.0.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
